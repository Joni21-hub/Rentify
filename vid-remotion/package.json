{
  "name": "vid-remotion",
  "version": "1.0.0",
  "description": "A Remotion template for TikTok-style captions",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/animation-utils": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/layout-utils": "4.0.539",
    "@remotion/media-utils": "4.0.539",
    "@remotion/tailwind-v4": "4.0.539",
    "@remotion/zod-types": "4.0.539",
    "lucide-react": "^1.66.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "tailwindcss": "4.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/captions": "4.0.539",
    "@remotion/eslint-config-flat": "4.0.539",
    "@remotion/install-whisper-cpp": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "create-subtitles": "node sub.mjs",
    "render:ui": "remotion render RentifyUIShowcase out/RentifyUIShowcase.mp4",
    "render:brand": "remotion render RentifyBrandPromo out/RentifyBrandPromo.mp4",
    "render:product": "remotion render ProductCatalogPromo out/ProductCatalogPromo.mp4",
    "render:owner": "remotion render OwnerYieldPromo out/OwnerYieldPromo.mp4",
    "render:flash": "remotion render FlashDealPromo out/FlashDealPromo.mp4",
    "render:howitworks": "remotion render HowItWorksPromo out/HowItWorksPromo.mp4",
    "render:outdoor": "remotion render OutdoorCampingPromo out/OutdoorCampingPromo.mp4",
    "render:all": "npm run render:ui && npm run render:brand && npm run render:product && npm run render:owner && npm run render:flash && npm run render:howitworks && npm run render:outdoor",
    "preview:ui": "remotion still RentifyUIShowcase out/ui-preview.png --frame=180",
    "preview:all": "npm run preview:ui && remotion still RentifyBrandPromo out/brand-preview.png --frame=60 && remotion still ProductCatalogPromo out/product-preview.png --frame=40 && remotion still OwnerYieldPromo out/owner-preview.png --frame=50 && remotion still FlashDealPromo out/flash-preview.png --frame=30 && remotion still HowItWorksPromo out/howitworks-preview.png --frame=100 && remotion still OutdoorCampingPromo out/outdoor-preview.png --frame=40"
  },
  "allowScripts": {
    "esbuild": false
  },
  "sideEffects": [
    "*.css"
  ]
}

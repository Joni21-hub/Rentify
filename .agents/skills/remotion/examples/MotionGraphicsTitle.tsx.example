import React from 'react';
import {
  AbsoluteFill,
  interpolate,
  spring,
  useCurrentFrame,
  useVideoConfig,
} from 'remotion';

export interface MotionGraphicsTitleProps {
  headline: string;
  subheadline: string;
  badgeText?: string;
  themeColor?: string;
}

export const MotionGraphicsTitle: React.FC<MotionGraphicsTitleProps> = ({
  headline = 'KREASIKAN PROMOSI TANPA BATAS',
  subheadline = 'Automasi video marketing cerdas berbasis data katalog Rentify',
  badgeText = 'TEKNOLOGI REMOTION',
  themeColor = '#38bdf8',
}) => {
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();

  // Words split for staggered kinetic entrance
  const words = headline.split(' ');

  // Background grid animation
  const gridOffsetY = interpolate(frame, [0, 150], [0, 60]);

  return (
    <AbsoluteFill
      style={{
        backgroundColor: '#030712',
        color: '#ffffff',
        fontFamily: 'Inter, system-ui, sans-serif',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        overflow: 'hidden',
      }}
    >
      {/* Animated Subtle Tech Grid */}
      <div
        style={{
          position: 'absolute',
          inset: -100,
          backgroundImage: `linear-gradient(to right, rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.05) 1px, transparent 1px)`,
          backgroundSize: '80px 80px',
          transform: `translateY(${gridOffsetY}px)`,
        }}
      />

      {/* Radial Glow */}
      <div
        style={{
          position: 'absolute',
          width: 700,
          height: 700,
          borderRadius: '50%',
          background: `radial-gradient(circle, ${themeColor}33 0%, transparent 70%)`,
          filter: 'blur(120px)',
        }}
      />

      {/* Main Content Container */}
      <div
        style={{
          display: 'flex',
          flexDirection: 'column',
          alignItems: 'center',
          textAlign: 'center',
          maxWidth: 920,
          zIndex: 10,
          padding: '0 40px',
        }}
      >
        {/* Badge */}
        {badgeText && (
          <div
            style={{
              transform: `scale(${spring({
                frame,
                fps,
                config: { damping: 12, mass: 0.5, stiffness: 140 },
              })})`,
              backgroundColor: 'rgba(56, 189, 248, 0.1)',
              border: `1px solid ${themeColor}66`,
              color: themeColor,
              fontWeight: 700,
              fontSize: 18,
              letterSpacing: 2,
              padding: '10px 24px',
              borderRadius: 999,
              marginBottom: 32,
              textTransform: 'uppercase',
            }}
          >
            {badgeText}
          </div>
        )}

        {/* Staggered Words Title */}
        <h1
          style={{
            display: 'flex',
            flexWrap: 'wrap',
            justifyContent: 'center',
            gap: '16px 24px',
            fontSize: 72,
            fontWeight: 900,
            lineHeight: 1.1,
            letterSpacing: -1,
            marginBottom: 28,
          }}
        >
          {words.map((word, i) => {
            const wordDelay = 8 + i * 5;
            const wordSpring = spring({
              frame: frame - wordDelay,
              fps,
              config: { damping: 14, mass: 0.6, stiffness: 130 },
              from: 0,
              to: 1,
            });

            const translateY = interpolate(wordSpring, [0, 1], [60, 0]);
            const opacity = interpolate(wordSpring, [0, 1], [0, 1]);

            return (
              <span
                key={i}
                style={{
                  display: 'inline-block',
                  transform: `translateY(${translateY}px)`,
                  opacity,
                  color: i % 2 === 1 ? themeColor : '#ffffff',
                }}
              >
                {word}
              </span>
            );
          })}
        </h1>

        {/* Subtitle */}
        <p
          style={{
            fontSize: 26,
            color: '#94a3b8',
            maxWidth: 720,
            lineHeight: 1.5,
            opacity: interpolate(frame, [30, 45], [0, 1], {
              extrapolateLeft: 'clamp',
              extrapolateRight: 'clamp',
            }),
            transform: `translateY(${interpolate(frame, [30, 45], [20, 0], {
              extrapolateLeft: 'clamp',
              extrapolateRight: 'clamp',
            })}px)`,
          }}
        >
          {subheadline}
        </p>
      </div>
    </AbsoluteFill>
  );
};
